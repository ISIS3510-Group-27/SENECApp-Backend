# Production settings for docker-compose.prod.yml (see docs/deploy-aws.md).
# On the server: cp .env.production.example .env  and fill in the CHANGE_ME values.
# Keep comments on their own lines.

# Public hostname of the server. With an Elastic IP 3.85.12.34 you can use 3-85-12-34.sslip.io
DOMAIN=CHANGE_ME.sslip.io

APP_NAME=SENECApp Backend
# "production" refuses AUTH_PROVIDER=dev and database resets.
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
# Mobile apps don't need CORS; only list web origins that should call the API.
CORS_ORIGINS=https://CHANGE_ME.sslip.io

# --- Database (private to the server; never published) ---
POSTGRES_USER=senecapp
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=senecapp

# --- Seeding ---
# full = catalog + simulated demo history (generated once, on first start)
SEED_MODE=full

# --- Authentication (never "dev" on a public server) ---
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=senecapp
ALLOWED_EMAIL_DOMAINS=uniandes.edu.co
REQUIRE_VERIFIED_EMAIL=true

# --- Push notifications ---
# Copy the key to ./secrets/firebase-service-account.json on the server.
PUSH_PROVIDER=fcm
FIREBASE_CREDENTIALS_PATH=/code/secrets/firebase-service-account.json

# --- Campus & context-aware features ---
CAMPUS_TIMEZONE=America/Bogota
CHECK_IN_OPENS_MINUTES=30
CHECK_IN_CLOSES_MINUTES=15
CHECK_IN_MAX_DISTANCE_M=500

# --- Operations ---
SCHEDULER_ENABLED=true
ADMIN_EMAILS=n.salazars@uniandes.edu.co,c.castilla@uniandes.edu.co
