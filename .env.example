# cp this file to .env and adjust values as needed.

APP_NAME=SENECApp Backend
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed origins (* for local development)
CORS_ORIGINS=*

# --- Database (used by docker-compose and the API) ---
POSTGRES_USER=senecapp
POSTGRES_PASSWORD=senecapp
POSTGRES_DB=senecapp
POSTGRES_PORT=5433
API_PORT=8000

# Connection string used when running the API outside Docker.
# Inside docker-compose this is overridden to point at the "db" service.
DATABASE_URL=postgresql+psycopg://senecapp:senecapp@localhost:5433/senecapp

# --- Seeding (runs on every container start; idempotent) ---
# none      -> do not seed
# reference -> catalog data (categories, interests, campus buildings, groups)
# full      -> catalog + ~12 weeks of simulated usage for the analytics (generated once)
SEED_MODE=full

# --- Authentication ---
# dev      -> accepts "Authorization: Bearer dev:<email>" (local development only)
# firebase -> verifies Firebase ID tokens (requires FIREBASE_PROJECT_ID)
AUTH_PROVIDER=dev
FIREBASE_PROJECT_ID=
ALLOWED_EMAIL_DOMAINS=uniandes.edu.co
REQUIRE_VERIFIED_EMAIL=true

# --- Push notifications ---
# none -> in-app notifications only. fcm -> also push through Firebase Cloud Messaging.
PUSH_PROVIDER=none
# Service-account JSON (Firebase console > Project settings > Service accounts).
# Put it in ./secrets/ (git-ignored); inside Docker it is mounted at /code/secrets/.
FIREBASE_CREDENTIALS_PATH=

# --- Campus & context-aware features ---
CAMPUS_TIMEZONE=America/Bogota
CHECK_IN_OPENS_MINUTES=30
CHECK_IN_CLOSES_MINUTES=15
CHECK_IN_MAX_DISTANCE_M=500

# --- Operations ---
# Background jobs (re-engagement experiment, recommender training) inside the API process.
SCHEDULER_ENABLED=true
# Comma-separated emails allowed to use /admin and /analytics/bq endpoints.
ADMIN_EMAILS=admin@uniandes.edu.co,n.salazars@uniandes.edu.co
