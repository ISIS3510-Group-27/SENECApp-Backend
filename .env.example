# cp this file to .env and adjust values as needed.

APP_NAME=SENECApp Backend
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed origins (* for local development)
CORS_ORIGINS=*

# --- Database (used by docker-compose and the API) ---
POSTGRES_USER=senecapp
POSTGRES_PASSWORD=senecapp
POSTGRES_DB=senecapp
POSTGRES_PORT=5433
API_PORT=8000

# Connection string used when running the API outside Docker.
# Inside docker-compose this is overridden to point at the "db" service.
DATABASE_URL=postgresql+psycopg://senecapp:senecapp@localhost:5433/senecapp

# --- Seeding ---
# none      -> do not seed
# reference -> catalog data (categories, interests, campus buildings, groups)
SEED_MODE=reference

# --- Authentication ---
# dev      -> accepts "Authorization: Bearer dev:<email>" (local development only)
# firebase -> verifies Firebase ID tokens (requires FIREBASE_PROJECT_ID)
AUTH_PROVIDER=dev
FIREBASE_PROJECT_ID=
ALLOWED_EMAIL_DOMAINS=uniandes.edu.co
REQUIRE_VERIFIED_EMAIL=true
